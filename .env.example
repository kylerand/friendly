# ============================================================================
# Friendly Backend — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in your values.
#
# LOCAL DEV:  Use your Supabase project's development credentials.
# PILOT:      Set these in the Railway dashboard → Variables.
# ============================================================================

# -- Supabase Project --
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://fjufukkcezipmnfeibkt.supabase.co
# New Supabase key layout (2024+): prefer project keys and the JWT secret
# See: https://github.com/supabase/discussions/issues/29260 for background
SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# -- Supabase JWT Secret --
# Found in: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_jwt_secret_here

# -- Database (direct Postgres connection) --
# Found in: Supabase Dashboard → Settings → Database → Connection string
# Use the "Connection pooling" URI for production.
DATABASE_URL=postgresql://postgres:sE7Zf$k_wkT2VWZ@db.fjufukkcezipmnfeibkt.supabase.co:5432/postgres

# -- App --
ENVIRONMENT=development  # "development" | "pilot"
ALLOWED_ORIGINS=*        # Comma-separated origins for CORS
LOG_LEVEL=info
